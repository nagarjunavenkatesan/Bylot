{
  "name": "bylot-backend",
  "version": "1.0.0",
  "description": "Centralized Express/MySQL backend API for Bylot Android, website, and admin panel.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "schema": "node scripts/runSchema.js",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/createAdmin.js",
    "verify-user": "node scripts/verifyUser.js",
    "security-audit": "node scripts/securityAudit.js",
    "seed-benchmark": "node scripts/seedBenchmark.js",
    "benchmark": "node scripts/benchmark.js",
    "mcp": "node mcp/server.js",
    "lint": "eslint .",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "bylot",
    "marketplace",
    "express",
    "mysql"
  ],
  "author": "Bylot",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "file-type": "^22.1.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.14",
    "sharp": "^0.35.5",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "globalTeardown": "<rootDir>/tests/globalTeardown.js"
  }
}
