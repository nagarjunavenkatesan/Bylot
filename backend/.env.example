NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bylot
DB_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Bylot <no-reply@bylot.com>"

PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=replace_with_payment_webhook_secret
