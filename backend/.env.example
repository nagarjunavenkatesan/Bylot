# ==============================================================================
# BYLOT Backend Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
API_BASE_URL=https://bylot.in/api
FRONTEND_URL=https://bylot.in
ALLOWED_ORIGINS=https://bylot.in,https://www.bylot.in,http://localhost:5173

# MySQL Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=bylot_user
DB_PASSWORD=your_secure_db_password
DB_NAME=bylot
DB_CONNECTION_LIMIT=10

# JWT Authentication Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_jwt_secret
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# Authorized JavaScript Origins: https://bylot.in, http://localhost:5173
# Authorized Redirect URIs: https://bylot.in/login
GOOGLE_CLIENT_ID=358858464400-6di0qk18deq2fejn7g3f830i2g5fr1nf.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Upload & Storage Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# SMTP / Email Configuration (Optional - for notifications/password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Bylot <no-reply@bylot.in>"

# Payment Configuration
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=replace_with_payment_webhook_secret
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@bylot.in
ADMIN_PASSWORD=replace_with_secure_initial_admin_password
ADMIN_NAME="Bylot Administrator"

# Telegram Notification Bot (Optional)
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token

# MCP Server Security
MCP_AUTH_KEY=replace_with_admin_mcp_auth_token
