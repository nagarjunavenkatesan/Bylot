# ==============================================================================
# BYLOT BACKEND — Environment Security & Cryptographic Configuration (654 Format)
# File Permission Recommendation: chmod 654 or chmod 600
# NEVER commit the filled-in .env file to version control.
# ==============================================================================

# ── Cryptography & Data Encryption (AES-256-GCM) ─────────────────────────────
# 32+ character high-entropy key used by cryptoUtil to encrypt PII and sensitive data at rest
ENCRYPTION_KEY=REPLACE_ME_32_byte_aes_256_gcm_master_encryption_key!

# ── Server Environment ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
API_BASE_URL=https://your-domain.example.com/api
FRONTEND_URL=https://your-domain.example.com
APP_URL=https://your-domain.example.com
ALLOWED_ORIGINS=https://your-domain.example.com,https://www.your-domain.example.com

# ── MySQL Database Security ───────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=REPLACE_ME_db_user
DB_PASSWORD=REPLACE_ME_strong_db_password
DB_NAME=bylot
DB_CONNECTION_LIMIT=10

# ── JWT Authentication & Tokens ───────────────────────────────────────────────
# Generate high entropy secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME_min_32_chars_high_entropy_access_secret
JWT_REFRESH_SECRET=REPLACE_ME_min_32_chars_different_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ── Cookie Security Policies ──────────────────────────────────────────────────
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# ── Reverse Proxy Trust ───────────────────────────────────────────────────────
# 0 = direct Node (no reverse proxy)
# 1 = single reverse proxy (host Nginx)
# 2 = Cloudflare + host reverse proxy
# 3 = Cloudflare + load balancer + host reverse proxy
TRUST_PROXY_HOPS=1

# ── Google OAuth 2.0 Credentials ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_ME_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME_google_client_secret

# ── File Upload Quota & Storage ───────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
UPLOAD_QUOTA_PER_DAY=20

# ── SMTP Mailer Configuration ─────────────────────────────────────────────────
SMTP_HOST=smtp.your-email-provider.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME_smtp_username
SMTP_PASS=REPLACE_ME_smtp_password
EMAIL_FROM=Bylot <no-reply@your-domain.example.com>

# ── Admin Account Initialization ──────────────────────────────────────────────
ADMIN_EMAIL=REPLACE_ME_admin@your-domain.example.com
ADMIN_PASSWORD=REPLACE_ME_secure_initial_admin_password
ADMIN_NAME=Bylot Administrator

# ── Model Context Protocol (MCP) Auth ─────────────────────────────────────────
MCP_AUTH_KEY=REPLACE_ME_random_mcp_auth_key
