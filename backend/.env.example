# ==============================================================================
# BYLOT BACKEND — Environment Configuration Template
# Copy this file to .env and fill in every value marked REPLACE_ME.
# NEVER commit the filled-in .env file.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
API_BASE_URL=https://your-domain.example.com/api
FRONTEND_URL=https://your-domain.example.com
APP_URL=https://your-domain.example.com
ALLOWED_ORIGINS=https://your-domain.example.com,https://www.your-domain.example.com

# ── MySQL Database ────────────────────────────────────────────────────────────
# Database host inside Docker is usually the service name "mysql"
DB_HOST=mysql
DB_PORT=3306
DB_USER=REPLACE_ME_db_user
DB_PASSWORD=REPLACE_ME_strong_db_password
DB_NAME=bylot
DB_CONNECTION_LIMIT=10

# ── JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME_min_32_chars_high_entropy_access_secret
JWT_REFRESH_SECRET=REPLACE_ME_min_32_chars_different_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ── Refresh cookie settings ───────────────────────────────────────────────────
# Set COOKIE_SAMESITE=none and COOKIE_DOMAIN=.your-domain.example.com
# when the API and frontend are on different subdomains (requires HTTPS).
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# ── Proxy trust ───────────────────────────────────────────────────────────────
# Count the number of reverse proxies between the internet and Node.
# Example: Cloudflare (1) + nginx (1) = 2
TRUST_PROXY_HOPS=2

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
# Authorized JavaScript Origins: https://your-domain.example.com
# Authorized Redirect URIs: https://your-domain.example.com/login
GOOGLE_CLIENT_ID=REPLACE_ME_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME_google_client_secret

# ── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
# Max uploads per user per day (upload quota)
UPLOAD_QUOTA_PER_DAY=20

# ── SMTP / Email ─────────────────────────────────────────────────────────────
# Required in production — the app refuses to start without SMTP configured.
SMTP_HOST=smtp.your-email-provider.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME_smtp_username
SMTP_PASS=REPLACE_ME_smtp_password
EMAIL_FROM=Bylot <no-reply@your-domain.example.com>

# ── Admin seed ────────────────────────────────────────────────────────────────
# Used only by `npm run create-admin` on first deploy.
# Remove or blank out after the first admin account is created.
ADMIN_EMAIL=REPLACE_ME_admin@your-domain.example.com
ADMIN_PASSWORD=REPLACE_ME_secure_initial_admin_password
ADMIN_NAME=Bylot Administrator

# ── MCP server ────────────────────────────────────────────────────────────────
# Auth key for the Model Context Protocol admin endpoint.
MCP_AUTH_KEY=REPLACE_ME_random_mcp_auth_key

# ── NOTE ──────────────────────────────────────────────────────────────────────
# If any secret (DB_PASSWORD, JWT secrets, etc.) has ever appeared in logs,
# chat history, or version control, treat it as COMPROMISED and rotate it
# before deploying. See docs/DEPLOYMENT.md for the full security checklist.
