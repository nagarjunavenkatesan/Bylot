# ==============================================================================
# BYLOT FRONTEND — Environment Configuration Template
# Copy this file to .env in the bylot/ folder.
# NEVER commit the filled-in .env to version control.
# ==============================================================================

# ── API backend URL ───────────────────────────────────────────────────────────
# Leave empty to use Vite's dev proxy (/api → localhost:5000).
# In production behind the same nginx: leave empty or set to the public domain.
VITE_API_BASE_URL=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create a Web client ID in Google Cloud Console → APIs & Services → Credentials
# Authorised JavaScript Origins: https://your-domain.example.com
VITE_GOOGLE_CLIENT_ID=REPLACE_ME_google_client_id.apps.googleusercontent.com

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to "true" only for offline demos — shows hardcoded sample products.
VITE_DEMO_MODE=false
