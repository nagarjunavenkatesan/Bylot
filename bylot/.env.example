# ==============================================================================
# BYLOT Frontend Environment Configuration (Vite)
# Note: Variables prefixed with VITE_ are embedded into frontend client bundle.
# NEVER put private keys, database passwords, or JWT secrets in this file.
# ==============================================================================

# API Base URL:
# Leave empty ("") when using Nginx reverse proxy or Vite dev proxy (/api -> backend)
# Set to "http://localhost:5000" if running backend without proxy during local development
VITE_API_BASE_URL=

# Google OAuth 2.0 Web Client ID (Public client ID - safe for frontend)
# Configured in Google Cloud Console for origins: http://localhost:5173, https://bylot.in
VITE_GOOGLE_CLIENT_ID=358858464400-6di0qk18deq2fejn7g3f830i2g5fr1nf.apps.googleusercontent.com

# Demo Mode:
# When false (default for production), failed API calls show error states rather than mock products
VITE_DEMO_MODE=false
