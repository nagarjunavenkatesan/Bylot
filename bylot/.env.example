# ==============================================================================
# BYLOT FRONTEND — Environment Security Configuration Template (654 Format)
# Permission Mode: chmod 654 or chmod 600
# Copy this file to .env in the bylot/ directory.
# NEVER commit filled-in .env files to version control.
# ==============================================================================

# ── Site Canonical Domain ─────────────────────────────────────────────────────
VITE_SITE_URL=https://bylot.in

# ── API Backend URL ───────────────────────────────────────────────────────────
# Leave blank to use Vite dev proxy (/api → localhost:5000).
# In production behind Nginx/CORS, specify the public API endpoint.
VITE_API_BASE_URL=

# ── Google OAuth Client ID ────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=REPLACE_ME_google_client_id.apps.googleusercontent.com

# ── Demo / Offline Mode ───────────────────────────────────────────────────────
VITE_DEMO_MODE=false
