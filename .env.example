# ==============================================================================
# BYLOT — Docker & System Master Environment Template (654 Format)
# File Permission Requirement: chmod 654 or chmod 600
# Copy to .env in the project root before running docker compose.
# NEVER commit filled-in .env files to version control.
# ==============================================================================

# ── Cryptography & PII Security ───────────────────────────────────────────────
ENCRYPTION_KEY=REPLACE_ME_32_byte_aes_256_gcm_master_encryption_key!

# ── Database Security Credentials ──────────────────────────────────────────────
DB_NAME=bylot
DB_USER=REPLACE_ME_db_user
DB_PASSWORD=REPLACE_ME_strong_db_password
MYSQL_ROOT_PASSWORD=REPLACE_ME_strong_mysql_root_password

# ── Cryptographic JWT Secrets ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME_min_32_chars_high_entropy_access_secret
JWT_REFRESH_SECRET=REPLACE_ME_min_32_chars_different_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Domain & Network Security ──────────────────────────────────────────────────
FRONTEND_URL=https://your-domain.example.com
APP_URL=https://your-domain.example.com
ALLOWED_ORIGINS=https://your-domain.example.com,https://www.your-domain.example.com

# ── Google OAuth 2.0 Credentials ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_ME_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME_google_client_secret

# ── Mail Server Delivery (Production Required) ─────────────────────────────────
SMTP_HOST=smtp.your-email-provider.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME_smtp_username
SMTP_PASS=REPLACE_ME_smtp_password
EMAIL_FROM=Bylot <no-reply@your-domain.example.com>

# ── Proxy Hops ────────────────────────────────────────────────────────────────
TRUST_PROXY_HOPS=2
